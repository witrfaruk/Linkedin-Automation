# ==========================================
# 1. AI & SEARCH API KEYS
# ==========================================
ANTHROPIC_API_KEY=
# (Optional) Defaults to claude-fable-5-1
ANTHROPIC_MODEL=claude-fable-5-1
TAVILY_API_KEY=

# ==========================================
# 2. TOPIC & SEARCH CONFIGURATION
# ==========================================
# (Required) Define the search query or keywords for your niche
# Example: SEARCH_QUERY="Artificial Intelligence OR Machine Learning OR LLMs"
SEARCH_QUERY=

# (Optional) Comma-separated list of domains to search from (leave empty to search all)
# Example: INCLUDE_DOMAINS=theverge.com,wired.com,bloomberg.com
INCLUDE_DOMAINS=

# (Optional) Comma-separated list of domains to block/exclude (leave empty if none)
# Example: EXCLUDE_DOMAINS=reddit.com,quora.com,medium.com
EXCLUDE_DOMAINS=

# (Optional) Number of days of past news to fetch (default: 1)
SEARCH_DAYS=1

# (Optional) Number of results to fetch per run (default: 30)
SEARCH_MAX_RESULTS=30

# ==========================================
# 3. LINKEDIN CREDENTIALS
# ==========================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_REFRESH_TOKEN=

